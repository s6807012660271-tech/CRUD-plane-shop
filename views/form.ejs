<h1 class="h4 mb-3"><%= title %></h1>

<% if (errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0">
    <% errors.forEach(e => { %><li><%= e %></li><% }) %>
  </ul></div>
<% } %>

<form method="<%= method %>" action="<%= action %>" class="card card-body shadow-sm">
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">ชื่อรุ่น *</label>
      <input name="name" class="form-control" value="<%= plane.name || '' %>" required>
    </div>
    <div class="col-md-3">
      <label class="form-label">ผู้ผลิต *</label>
      <select name="manufacturer" class="form-select" required>
        <% ['Boeing','Airbus','Cessna','Embraer','Bombardier','Gulfstream','ATR','Lockheed Martin','SAAB','Kramenka Industries','Other'].forEach(m => { %>
          <option value="<%= m %>" <%= plane.manufacturer === m ? 'selected' : '' %>><%= m %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label">ประเภท *</label>
      <select name="category" class="form-select" required>
        <% ['Commercial','Private Jet','Cargo','Trainer','Helicopter','Fighter Jet','Military'].forEach(c => { %>
          <option value="<%= c %>" <%= plane.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label">ปีผลิต *</label>
      <input type="number" name="year" class="form-control" value="<%= plane.year || new Date().getFullYear() %>" required>
    </div>
    <div class="col-md-3">
      <label class="form-label">ราคา (USD) *</label>
      <input type="number" step="0.01" name="price" class="form-control" value="<%= plane.price || '' %>" required>
    </div>
    <div class="col-md-2">
      <label class="form-label">ที่นั่ง</label>
      <input type="number" name="seats" class="form-control" value="<%= plane.seats || 0 %>">
    </div>
    <div class="col-md-2">
      <label class="form-label">พิสัย (km)</label>
      <input type="number" name="rangeKm" class="form-control" value="<%= plane.rangeKm || 0 %>">
    </div>
    <div class="col-md-2">
      <label class="form-label">สต็อก</label>
      <input type="number" name="stock" class="form-control" value="<%= plane.stock != null ? plane.stock : 1 %>">
    </div>
    <div class="col-md-3">
      <label class="form-label">สภาพ</label>
      <select name="condition" class="form-select">
        <option value="New"  <%= plane.condition === 'New' ? 'selected' : '' %>>New</option>
        <option value="Used" <%= plane.condition === 'Used' ? 'selected' : '' %>>Used</option>
      </select>
    </div>
    <div class="col-md-9">
      <label class="form-label">Image URL</label>
      <input name="imageUrl" class="form-control" value="<%= plane.imageUrl || '' %>">
    </div>
    <div class="col-12">
      <label class="form-label">รายละเอียด</label>
      <textarea name="description" rows="3" class="form-control"><%= plane.description || '' %></textarea>
    </div>
  </div>
  <div class="mt-3 d-flex gap-2">
    <button class="btn btn-primary">บันทึก</button>
    <a href="/planes" class="btn btn-secondary">ยกเลิก</a>
  </div>
</form>